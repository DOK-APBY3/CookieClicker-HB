<Window x:Class="CookieClicker_HB.ClickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CookieClicker_HB"
        mc:Ignorable="d"
        Title="ClickerWindow" Height="550" Width="800">

    <Window.Resources>
        <local:bigToString x:Key="myBigConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,5,5">

            <Button Height="30" Width="30" Name="EscapeButton" Click="EscapeButton_Click">
                <TextBlock Text="ESC" FontSize="10"/>
            </Button>
            <Button Height="30" Width="30" Name="BackButton" Click="BackButton_Click">
                <TextBlock Text="BACK" FontSize="10"/>
            </Button>
            <!--<Button Height="30" Width="30" Name="SavingButton" Click="SavingButton_Click">
                <TextBlock Text="SAVE" FontSize="10"/>
            </Button>
            <Button Height="30" Width="30" Name="LoadingButton" Click="LoadingButton_Click">
                <TextBlock Text="LOAD" FontSize="10"/>
            </Button>-->

        </StackPanel>

        <StackPanel Grid.Row="1" Name="SimpleStatsPanel">
            <StackPanel Orientation="Horizontal" Margin="5">
                
                <Image Height="50" Width="50" Source="/icons/Interfase/icon_money.png"/>

                <TextBlock x:Name="Gold_TB" Text="{Binding Path=Gold, Converter={StaticResource myBigConverter}}" FontSize="30" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                
                <Image Height="50" Width="50" Source="/icons/Interfase/icon_damage.png"/>
                <TextBlock x:Name="Damage_TB" Text="{Binding Path=Damage, Converter={StaticResource myBigConverter}}" FontSize="30" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal" Margin="5" Name="PlayerUpgrasePanel">
                <TextBlock Text=" Меч " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock  Text="{Binding Path=SwordLvl}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <Button Click="SwordUpgrade_Click">
                    <Image Height="50" Width="50" Source="/icons/Interfase/icon_upgrade.png"/>
                </Button>
                <TextBlock  Text="{Binding Path=SwordUpgradeCost, Converter={StaticResource myBigConverter}}" FontSize="30" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5" Name="PlayerClickUpgrasePanel">
                <TextBlock Text="Клик " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock  Text="{Binding Path=ClickLvl}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <Button Click="ClickUpgrade_Click">
                    <Image Height="50" Width="50" Source="/icons/Interfase/icon_upgrade.png"/>
                </Button>
                <TextBlock  Text="{Binding Path=ClickupgradeCost, Converter={StaticResource myBigConverter}}" FontSize="30" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="EnemyPanel">

            <TextBlock x:Name="Enemy_Name" Text="{Binding Path=Name}" FontSize="30" TextAlignment="Center"/>

            <TextBlock x:Name="Enemy_HP" Text="{Binding Path=Current_hit_points}" FontSize="30" TextAlignment="Center"/>
            
            <ProgressBar x:Name="enemy_Hp" Width="150" Height="20" Margin="5" Background="Red"/> 
            <!--возможно реализовать полоску хп не получится и будет прото цифра-->

            <Grid x:Name="IconCanv" Height="220" Width="200" MouseLeftButtonDown="EnemyWasClicked" >

                <Image x:Name="EnemyIcon" Source="{Binding Path =Icon.ImagePath}"/>

                <Canvas Name="SphereContainer" MouseLeftButtonDown="SphereContainer_MouseLeftButtonDown" Background="Transparent" Width="190" Height="210"/>
            </Grid>

        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Name="GlobalStatPanel">

            <TextBlock Text="Денег заработано"  FontSize="30"/>
            <TextBlock Text="{Binding Path=GoldRaised, Converter={StaticResource myBigConverter}}"  FontSize="30" Margin="5" Name ="StatTotalMoney"/>
            <TextBlock Text="Урона нанесено"  FontSize="30"/>
            <TextBlock Text="{Binding Path=DamageDealed, Converter={StaticResource myBigConverter}}"  FontSize="30" Margin="5" Name ="StatTotalDamage"/>
            <TextBlock Text="Врагов убито"  FontSize="30"/>
            <TextBlock Text="{Binding Path=KilledEnemy}"  FontSize="30" Margin="5" Name ="StatTotalKills"/>

        </StackPanel>
    </Grid>
</Window>
